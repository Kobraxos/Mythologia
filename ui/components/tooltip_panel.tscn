[gd_scene load_steps=5 format=3 uid="uid://tooltip_panel_uid"]

[ext_resource type="Script" path="res://ui/components/tooltip_panel.gd" id="1_script"]
[ext_resource type="Theme" path="res://ui/themes/master_theme.tres" id="2_theme"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bg"]
bg_color = Color(0.0627451, 0.0627451, 0.0823529, 0.95)
border_width_left = 4
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.85098, 0.65098, 0.2, 1)
shadow_color = Color(0, 0, 0, 0.6)
shadow_size = 8
shadow_offset = Vector2(0, 4)

[node name="TooltipPanel" type="PanelContainer" node_paths=PackedStringArray("title_label", "description_label", "cost_label", "cooldown_label")]
custom_minimum_size = Vector2(250, 0)
offset_right = 250.0
offset_bottom = 100.0
mouse_filter = 2
theme = ExtResource("2_theme")
theme_override_styles/panel = SubResource("StyleBoxFlat_bg")
script = ExtResource("1_script")
title_label = NodePath("Margin/VBox/Header/TitleLabel")
description_label = NodePath("Margin/VBox/DescriptionLabel")
cost_label = NodePath("Margin/VBox/Header/CostLabel")
cooldown_label = NodePath("Margin/VBox/CooldownLabel")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="Header" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
mouse_filter = 2

[node name="TitleLabel" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2
theme_type_variation = &"HeaderLabel"
theme_override_colors/font_color = Color(0.960784, 0.929412, 0.85098, 1)
theme_override_font_sizes/font_size = 18
text = "Skill Title"
uppercase = true

[node name="CostLabel" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.4, 0.8, 1, 1)
theme_override_font_sizes/font_size = 16
text = "2 AP"
