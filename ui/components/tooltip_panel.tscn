[node name="HSeparator" type="HSeparator" parent="Margin/VBox"]
layout_mode = 2
mouse_filter = 2

[node name="DescriptionLabel" type="RichTextLabel" parent="Margin/VBox"]
layout_mode = 2
mouse_filter = 2
bbcode_enabled = true
text = "Skill description goes here..."
fit_content = true
scroll_active = false

[node name="CooldownLabel" type="Label" parent="Margin/VBox"]
